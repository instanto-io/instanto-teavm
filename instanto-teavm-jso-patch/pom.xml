<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <!-- Not instanto-teavm-parent: instanto-teavm-pom's teavm-compiler-fixes profile adds
       this artifact as a dependency, which would make it depend on itself. It pins its
       own TeaVM baseline and needs only the organisation's build conventions. -->
  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>instanto-org-pom</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath/>
  </parent>
  <artifactId>instanto-teavm-jso-patch</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>Instanto TeaVM JSO Patch</name>
  <description>TeaVM 0.16.0 JSO implementation that calls @JSTopLevel functions as plain global calls.</description>
  <properties>
    <!-- This is an exact upstream binary baseline, not a consumer override. -->
    <patched.teavm.version>0.16.0</patched.teavm.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.teavm</groupId><artifactId>teavm-jso-impl</artifactId>
      <version>${patched.teavm.version}</version><scope>provided</scope>
    </dependency>
    <!-- The replaced classes compile against the rest of TeaVM, which consumers already have. -->
    <dependency>
      <groupId>org.teavm</groupId><artifactId>teavm-core</artifactId>
      <version>${patched.teavm.version}</version><scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId><artifactId>teavm-classlib</artifactId>
      <version>${patched.teavm.version}</version><scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId><artifactId>teavm-junit</artifactId>
      <version>${patched.teavm.version}</version><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId><artifactId>junit</artifactId>
      <version>4.13.2</version><scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>upstream-jso-impl</id><phase>generate-resources</phase><goals><goal>unpack</goal></goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.teavm</groupId><artifactId>teavm-jso-impl</artifactId>
                  <version>${patched.teavm.version}</version>
                  <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                  <excludes>org/teavm/jso/impl/JS.class,org/teavm/jso/impl/JS$*.class,org/teavm/jso/impl/JSClassProcessor.class,org/teavm/jso/impl/JSClassProcessor$*.class,org/teavm/jso/impl/JSNativeInjector.class,org/teavm/jso/impl/JSNativeInjector$*.class</excludes>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>teavm-browser-tests</id>
      <properties>
        <teavm.junit.js>true</teavm.junit.js>
        <teavm.junit.wasm-gc>true</teavm.junit.wasm-gc>
        <teavm.junit.optimized>true</teavm.junit.optimized>
        <teavm.junit.minified>true</teavm.junit.minified>
      </properties>
      <build><plugins><plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
        <configuration><systemPropertyVariables>
          <teavm.junit.target>${project.build.directory}/teavm-tests</teavm.junit.target>
          <teavm.junit.js>${teavm.junit.js}</teavm.junit.js>
          <teavm.junit.wasm-gc>${teavm.junit.wasm-gc}</teavm.junit.wasm-gc>
          <teavm.junit.c>false</teavm.junit.c>
          <teavm.junit.optimized>${teavm.junit.optimized}</teavm.junit.optimized>
          <teavm.junit.minified>${teavm.junit.minified}</teavm.junit.minified>
          <teavm.junit.js.runner>browser-chrome</teavm.junit.js.runner>
          <teavm.junit.wasm-gc.runner>browser-chrome</teavm.junit.wasm-gc.runner>
        </systemPropertyVariables></configuration>
      </plugin></plugins></build>
    </profile>
  </profiles>
</project>
