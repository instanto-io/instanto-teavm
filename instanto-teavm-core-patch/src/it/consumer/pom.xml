<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.instanto</groupId><artifactId>instanto-teavm-pom</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath/>
  </parent>
  <groupId>io.instanto.fixture</groupId><artifactId>class-init-consumer</artifactId>
  <version>1.0-SNAPSHOT</version>
  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <fixture.optimization>SIMPLE</fixture.optimization>
    <fixture.minifying>false</fixture.minifying>
    <fixture.outputDirectory>${project.build.directory}/teavm</fixture.outputDirectory>
  </properties>
  <dependencies>
    <!-- Deliberately before the inherited patch dependency: test compilation
         must work regardless of project dependency declaration order. -->
    <dependency><groupId>org.teavm</groupId><artifactId>teavm-core</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>org.teavm</groupId><artifactId>teavm-classlib</artifactId></dependency>
    <dependency><groupId>org.teavm</groupId><artifactId>teavm-junit</artifactId><scope>test</scope></dependency>
    <dependency><groupId>junit</groupId><artifactId>junit</artifactId><version>4.13.2</version><scope>test</scope></dependency>
  </dependencies>
  <build><plugins><plugin>
    <groupId>org.teavm</groupId><artifactId>teavm-maven-plugin</artifactId>
    <configuration>
      <mainClass>example.InitializationApplication</mainClass>
      <targetType>JAVASCRIPT</targetType><jsModuleType>ES2015</jsModuleType>
      <optimizationLevel>${fixture.optimization}</optimizationLevel>
      <minifying>${fixture.minifying}</minifying>
      <targetDirectory>${fixture.outputDirectory}</targetDirectory><targetFileName>app.mjs</targetFileName>
    </configuration>
    <executions><execution><phase>prepare-package</phase><goals><goal>compile</goal></goals></execution></executions>
  </plugin></plugins></build>
</project>
