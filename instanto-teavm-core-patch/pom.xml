<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>instanto-teavm-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>instanto-teavm-core-patch</artifactId>
  <name>Instanto TeaVM Core Patch</name>
  <description>TeaVM 0.16.0 core with exception-safe class initialization elimination.</description>
  <properties>
    <!-- This is an exact upstream binary baseline, not a consumer override. -->
    <patched.teavm.version>0.16.0</patched.teavm.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.teavm</groupId><artifactId>teavm-core</artifactId>
      <version>${patched.teavm.version}</version><scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId><artifactId>teavm-classlib</artifactId>
      <version>${patched.teavm.version}</version><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId><artifactId>teavm-junit</artifactId>
      <version>${patched.teavm.version}</version><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId><artifactId>junit</artifactId>
      <version>4.13.2</version><scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions><execution>
          <id>consumer-scenarios</id><phase>generate-test-sources</phase><goals><goal>add-test-source</goal></goals>
          <configuration><sources><source>src/it/consumer/src/main/java</source></sources></configuration>
        </execution></executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>upstream-core</id><phase>generate-resources</phase><goals><goal>unpack</goal></goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.teavm</groupId><artifactId>teavm-core</artifactId>
                  <version>${patched.teavm.version}</version>
                  <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                  <excludes>org/teavm/model/optimization/ClassInitElimination*.class</excludes>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>teavm-browser-tests</id>
      <properties>
        <teavm.junit.js>true</teavm.junit.js>
        <teavm.junit.wasm-gc>true</teavm.junit.wasm-gc>
        <teavm.junit.optimized>true</teavm.junit.optimized>
        <teavm.junit.minified>true</teavm.junit.minified>
      </properties>
      <build><plugins><plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
        <configuration><systemPropertyVariables>
          <teavm.junit.target>${project.build.directory}/teavm-tests</teavm.junit.target>
          <teavm.junit.js>${teavm.junit.js}</teavm.junit.js>
          <teavm.junit.wasm-gc>${teavm.junit.wasm-gc}</teavm.junit.wasm-gc>
          <teavm.junit.c>false</teavm.junit.c>
          <teavm.junit.optimized>${teavm.junit.optimized}</teavm.junit.optimized>
          <teavm.junit.minified>${teavm.junit.minified}</teavm.junit.minified>
          <teavm.junit.js.runner>browser-chrome</teavm.junit.js.runner>
          <teavm.junit.wasm-gc.runner>browser-chrome</teavm.junit.wasm-gc.runner>
        </systemPropertyVariables></configuration>
      </plugin></plugins></build>
    </profile>
  </profiles>
</project>
